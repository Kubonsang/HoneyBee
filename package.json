{
  "name": "honey-bee",
  "version": "0.1.0-beta.6",
  "private": true,
  "type": "module",
  "description": "Windows Unity Workspace provider using Git worktrees and Library-only CoW.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kubonsang/HoneyBee.git"
  },
  "bugs": {
    "url": "https://github.com/Kubonsang/HoneyBee/issues"
  },
  "homepage": "https://github.com/Kubonsang/HoneyBee#readme",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "clean": "corepack pnpm -r --if-present clean",
    "deps:check": "depcruise --config dependency-cruiser.cjs apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "honeybee": "node apps/cli/dist/cli.js",
    "licenses:check": "node scripts/security/check-licenses.mjs",
    "package:release": "corepack pnpm --filter honeybee-cli package:smoke && corepack pnpm --filter honeybee-desktop package:smoke",
    "lint": "eslint . --max-warnings 0",
    "security:install-hooks": "git config core.hooksPath .githooks",
    "security:scan": "node scripts/security/check-no-secrets.mjs --all",
    "test": "corepack pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "verify": "corepack pnpm security:scan && corepack pnpm licenses:check && corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm build && corepack pnpm test:run && corepack pnpm deps:check",
    "test:run": "vitest run && corepack pnpm test:storage-host",
    "test:storage-host": "go -C tools/workspace-storage-host test ./..."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
