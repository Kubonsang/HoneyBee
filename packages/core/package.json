{
  "name": "@honeybee/core",
  "version": "0.1.0-beta.5",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./git-status": {
      "types": "./dist/git-status.d.ts",
      "import": "./dist/git-status.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "corepack pnpm clean && tsc -p tsconfig.build.json --pretty false",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.json --pretty false"
  },
  "license": "MIT"
}
