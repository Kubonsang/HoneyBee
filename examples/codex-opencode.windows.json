{
  "schemaVersion": 2,
  "steps": [
    {
      "id": "producer",
      "agent": {
        "command": "codex",
        "args": ["exec", "--sandbox", "read-only", "--ephemeral", "--skip-git-repo-check", "-"],
        "cwd": ".."
      }
    },
    {
      "id": "reviewer",
      "agent": {
        "command": "${APPDATA}\\npm\\node_modules\\opencode-ai\\bin\\opencode.exe",
        "args": ["run", "--pure"],
        "cwd": ".."
      }
    }
  ],
  "timeoutMs": 300000,
  "maxOutputBytes": 1048576
}
