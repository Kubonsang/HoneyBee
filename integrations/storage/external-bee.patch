+//go:build windows
+
+package workspace
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBeeWorkerProgressPreservesCopyAndDigest(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	target := filepath.Join(root, "target")
+	if err := os.Mkdir(source, 0700); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte("checkpoint"), 10000)
+	if err := os.WriteFile(filepath.Join(source, "payload"), payload, 0600); err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	tree, err := openBeeTreeProgress(source, 1, func() { count++ })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tree.close()
+	opened := count
+	if opened < 2 {
+		t.Fatal("missing open checkpoints")
+	}
+	if err = tree.copyTo(target, false); err != nil {
+		t.Fatal(err)
+	}
+	if count <= opened {
+		t.Fatal("missing copy checkpoints")
+	}
+	copied := count
+	digest, err := tree.digest()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count <= copied {
+		t.Fatal("missing digest checkpoints")
+	}
+	plain, err := openBeeTree(target, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer plain.close()
+	other, err := plain.digest()
+	if err != nil || digest != other {
+		t.Fatal("checkpoint changed copied bytes or digest", err)
+	}
+}
+
+func TestBeeTreeRejectsHardlinksAndReservesBusyFiles(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	os.Mkdir(source, 0700)
+	file := filepath.Join(source, "cache")
+	os.WriteFile(file, []byte("private"), 0600)
+	held, err := os.Open(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tree, e := openBeeTree(source, 2); e == nil {
+		tree.close()
+		t.Fatal("busy file reserved")
+	}
+	held.Close()
+	outside := filepath.Join(root, "alias")
+	if err = os.Link(file, outside); err != nil {
+		t.Fatal(err)
+	}
+	if tree, e := openBeeTree(source, 1); e == nil {
+		tree.close()
+		t.Fatal("hardlink read")
+	}
+	os.Remove(outside)
+	tree, err := openBeeTree(source, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tree.close()
+	if err = tree.remove(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Stat(source); !os.IsNotExist(err) {
+		t.Fatal("reserved tree remained")
+	}
+}
+func TestBeeSeedKeepsTundraAndRejectsChangedContent(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	os.Mkdir(source, 0700)
+	for _, name := range []string{"TundraBuildState.state", "TundraBuildState.state.map", "cache", "x.dag", "x-inputdata.json"} {
+		os.WriteFile(filepath.Join(source, name), []byte(name), 0600)
+	}
+	tree, err := openBeeTree(source, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dst := filepath.Join(root, "bee-seed")
+	err = tree.copyTo(dst, true)
+	tree.close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"TundraBuildState.state", "TundraBuildState.state.map", "cache"} {
+		if _, err = os.Stat(filepath.Join(dst, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = os.Stat(filepath.Join(dst, "x.dag")); !os.IsNotExist(err) {
+		t.Fatal("DAG copied")
+	}
+	tree, err = openBeeTree(dst, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash, err := tree.digest()
+	logical, allocated, e := tree.usage()
+	tree.close()
+	if err != nil || e != nil {
+		t.Fatal(err, e)
+	}
+	parent := ParentMetadata{CompatibilityKey: CompatibilityKey{Layout: ExternalBeeLayout}, VHDXPath: filepath.Join(root, "parent.vhdx"), BeeSeed: &BeeSeed{hash, logical, allocated}}
+	if err = verifyBeeSeed(parent); err != nil {
+		t.Fatal(err)
+	}
+	os.WriteFile(filepath.Join(dst, "cache"), []byte("other"), 0600)
+	if err = verifyBeeSeed(parent); err == nil {
+		t.Fatal("modified seed accepted")
+	}
+}
