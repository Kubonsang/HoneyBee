diff --git a/workspace/bee_commit.go b/workspace/bee_commit.go
new file mode 100644
index 0000000..b769743
--- /dev/null
+++ b/workspace/bee_commit.go
@@ -0,0 +1,52 @@
+package workspace
+
+import (
+	"errors"
+	"github.com/Kubonsang/unity-workspace-storage/internal/atomicfile"
+	"os"
+	"path/filepath"
+)
+
+// Publish the image, immutable seed and metadata by one directory rename.
+// Before publication a crash leaves the entire bundle in pending (recovery
+// quarantines it); after publication ResolveParent can see every component.
+func (s *Store) commitBeeParent(p *PendingParent, m ParentMetadata) (*ParentMetadata, error) {
+	dir := filepath.Dir(p.StagingPath)
+	final, err := s.paths.Parent(p.Key.Digest)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = os.Lstat(final); !os.IsNotExist(err) {
+		return nil, errors.Join(err, ErrParentConflict)
+	}
+	image := filepath.Join(dir, "parent.vhdx")
+	if err = atomicfile.Rename(p.StagingPath, image); err != nil {
+		return nil, err
+	}
+	rollback := func(primary error) (*ParentMetadata, error) {
+		_ = os.Remove(filepath.Join(dir, "COMPLETE"))
+		_ = os.Remove(filepath.Join(dir, "metadata.json"))
+		_ = os.Chmod(image, 0600)
+		return nil, errors.Join(primary, os.Rename(image, p.StagingPath))
+	}
+	m.SchemaVersion = ParentSchemaVersion
+	m.Provider = Provider
+	m.VHDXPath = filepath.Join(final, "parent.vhdx")
+	m.Immutable = true
+	m.CreatedAt = s.now().UTC()
+	m.LastUsedAt = m.CreatedAt
+	if err = os.Chmod(image, 0400); err != nil {
+		return rollback(err)
+	}
+	if err = writeJSONDurable(filepath.Join(dir, "metadata.json"), m); err != nil {
+		return rollback(err)
+	}
+	if err = atomicfile.WriteExclusiveDurable(filepath.Join(dir, "COMPLETE"), []byte(completeContents), 0600); err != nil {
+		return rollback(err)
+	}
+	if err = atomicfile.Rename(dir, final); err != nil {
+		return rollback(err)
+	}
+	_ = os.Remove(filepath.Join(final, "pending.json"))
+	return &m, nil
+}
