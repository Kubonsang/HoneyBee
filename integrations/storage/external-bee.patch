@@ -0,0 +1,78 @@
+package workspace
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestCommitObservationReadOnlyAuthenticated(t *testing.T) {
+	b, _, _ := testBroker(t, &fakeNative{})
+	query := request("observe-parent-commit", "probe")
+	capable := b.Handle(context.Background(), "S-1-5-21-test", query)
+	if !capable.OK || capable.CommitObservation.State != "capable" || capable.CommitObservation.BrokerSessionID == "" {
+		t.Fatalf("capability=%+v", capable)
+	}
+	if b.Handle(context.Background(), "other-sid", query).OK {
+		t.Fatal("unauthorized observation")
+	}
+	query.TargetRequestID = "missing"
+	query.TransactionID = "transaction"
+	if b.Handle(context.Background(), "S-1-5-21-test", query).CommitObservation.State != "unknown" {
+		t.Fatal("invented request")
+	}
+	if len(b.requests) != 0 || len(b.inflight) != 0 {
+		t.Fatal("observations pollute cache")
+	}
+}
+func TestCommitObservationTracksWorkerNotPolls(t *testing.T) {
+	b, key, workspaces := testBroker(t, &fakeNative{})
+	transaction := beginRecoveryParent(t, b, key, workspaces)
+	session := &gatedRecoverySession{ParentSession: b.parents[transaction], entered: make(chan struct{}), release: make(chan struct{})}
+	b.parents[transaction] = session
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	commit := request(OperationCommitParent, "observed-commit")
+	commit.TransactionID = transaction
+	done := make(chan Response, 1)
+	go func() { done <- b.Handle(ctx, "S-1-5-21-test", commit) }()
+	select {
+	case <-session.entered:
+	case <-ctx.Done():
+		t.Fatal("commit did not start")
+	}
+	query := request("observe-parent-commit", "observation")
+	query.TargetRequestID = commit.RequestID
+	query.TransactionID = transaction
+	first := b.Handle(ctx, "S-1-5-21-test", query).CommitObservation
+	second := b.Handle(ctx, "S-1-5-21-test", query).CommitObservation
+	if first.State != "running" || first.Sequence != second.Sequence || first.Phase != "finalize" {
+		t.Fatal("poll invented progress")
+	}
+	query.TransactionID = "wrong"
+	if b.Handle(ctx, "S-1-5-21-test", query).OK {
+		t.Fatal("wrong transaction accepted")
+	}
+	query.TransactionID = transaction
+	close(session.release)
+	select {
+	case response := <-done:
+		if !response.OK {
+			t.Fatalf("commit=%+v", response.Error)
+		}
+	case <-ctx.Done():
+		t.Fatal("commit did not finish")
+	}
+	final := b.Handle(ctx, "S-1-5-21-test", query).CommitObservation
+	if final.State != "completed" || final.Result == nil || !final.Result.OK || final.Result.RequestID != commit.RequestID || final.Sequence <= first.Sequence {
+		t.Fatalf("final=%+v", final)
+	}
+	restarted, err := NewBroker(b.config, &fakeNative{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	after := restarted.Handle(ctx, "S-1-5-21-test", query).CommitObservation
+	if after.State != "unknown" || after.BrokerSessionID == final.BrokerSessionID {
+		t.Fatal("restart confused identity")
+	}
+}
