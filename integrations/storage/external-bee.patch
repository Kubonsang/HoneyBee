@@ -0,0 +1,92 @@
+//go:build windows
+
+package workspace
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestBeeParentPublishesTogetherAndChargesSeed(t *testing.T) {
+	store, err := NewStore(t.TempDir(), "S-1-5-21-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := CompatibilityKey{SchemaVersion: ParentSchemaVersion, Layout: ExternalBeeLayout, Digest: strings.Repeat("f", 64)}
+	p, err := store.BeginParent("S-1-5-21-test", key, SourceSnapshot{}, filepath.Join(store.paths.Root, "mount"), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.WriteFile(p.StagingPath, make([]byte, 4097), 0600)
+	seed := filepath.Join(filepath.Dir(p.StagingPath), "bee-seed")
+	os.Mkdir(seed, 0700)
+	os.WriteFile(filepath.Join(seed, "cache"), make([]byte, 8193), 0600)
+	tree, err := openBeeTree(seed, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash, err := tree.digest()
+	logical, allocated, e := tree.usage()
+	tree.close()
+	if err != nil || e != nil {
+		t.Fatal(err, e)
+	}
+	disk, err := fileAllocatedBytes(p.StagingPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := ParentMetadata{CompatibilityKey: key, OwnershipToken: p.OwnershipToken, AllocatedBytes: disk, BeeSeed: &BeeSeed{hash, logical, allocated}}
+	committed, err := store.CommitParent(p, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Stat(filepath.Dir(p.StagingPath)); !os.IsNotExist(err) {
+		t.Fatal("pending bundle remained")
+	}
+	result, err := store.ResolveParent(key)
+	if err != nil || result.Status != ParentStatusValid {
+		t.Fatal("published parent missing", err)
+	}
+	if err = verifyBeeSeed(*committed); err != nil {
+		t.Fatal(err)
+	}
+	total, err := allocatedVHDXBytes(store.paths.UserRoot)
+	if err != nil || total != disk+allocated {
+		t.Fatalf("seed excluded from quota total=%d want=%d err=%v", total, disk+allocated, err)
+	}
+	reclaimed, err := store.RemoveParentIfUnused(key.Digest, map[string]bool{})
+	if err != nil || reclaimed != total {
+		t.Fatal("GC accounting mismatch", reclaimed, total, err)
+	}
+}
+func TestBeePendingRecoveryPreservesWholeUnpublishedBundle(t *testing.T) {
+	store, err := NewStore(t.TempDir(), "S-1-5-21-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := CompatibilityKey{SchemaVersion: ParentSchemaVersion, Layout: ExternalBeeLayout, Digest: strings.Repeat("d", 64)}
+	p, err := store.BeginParent("S-1-5-21-test", key, SourceSnapshot{}, filepath.Join(store.paths.Root, "mount"), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Dir(p.StagingPath)
+	os.WriteFile(filepath.Join(dir, "parent.vhdx"), []byte("image"), 0600)
+	os.Mkdir(filepath.Join(dir, "bee-seed"), 0700)
+	os.WriteFile(filepath.Join(dir, "bee-seed", "cache"), []byte("seed"), 0600)
+	_, quarantined, err := store.RecoverPending(time.Now().Add(time.Hour), time.Second, func(int) bool { return false })
+	if err != nil || quarantined != 1 {
+		t.Fatal("bundle recovery failed", quarantined, err)
+	}
+	for _, rel := range []string{"parent.vhdx", "bee-seed/cache"} {
+		if _, err = os.Stat(filepath.Join(store.paths.Quarantine, p.TransactionID+"-parent", filepath.FromSlash(rel))); err != nil {
+			t.Fatal(err)
+		}
+	}
+	result, err := store.ResolveParent(key)
+	if err != nil || result.Status != ParentStatusMissing {
+		t.Fatal("incomplete bundle published", err)
+	}
+}
diff --git a/workspace/bee_compression_windows.go b/workspace/bee_compression_windows.go
new file mode 100644
index 0000000..e0e793b
--- /dev/null
+++ b/workspace/bee_compression_windows.go
@@ -0,0 +1,34 @@
+//go:build windows
+
+package workspace
+
+import (
+	"errors"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func compressBeeCache(root string) (err error) {
+	// Validate and pin the entire tree before changing any attributes. Reparse
+	// points, hard links and conflicting writers fail before the first mutation.
+	tree, err := openBeeTree(root, 3)
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, tree.close()) }()
+	for _, node := range tree.nodes {
+		format := uint16(1) // COMPRESSION_FORMAT_DEFAULT: mutable NTFS compression.
+		var returned uint32
+		if err = windows.DeviceIoControl(windows.Handle(node.file.Fd()), 0x9c040,
+			(*byte)(unsafe.Pointer(&format)), 2, nil, 0, &returned, nil); err != nil {
+			return err
+		}
+		if !node.info.IsDir() {
+			if err = node.file.Sync(); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
diff --git a/workspace/bee_compression_windows_test.go b/workspace/bee_compression_windows_test.go
new file mode 100644
index 0000000..10ef3f6
--- /dev/null
+++ b/workspace/bee_compression_windows_test.go
@@ -0,0 +1,92 @@
+//go:build windows
+
+package workspace
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func requireBeeCompressed(t *testing.T, path string, want bool) {
+	t.Helper()
+	p, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	attrs, err := windows.GetFileAttributes(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if (attrs&windows.FILE_ATTRIBUTE_COMPRESSED != 0) != want {
+		t.Fatalf("compression attribute %s: %x, want %t", path, attrs, want)
+	}
+}
+
+func TestBeeCompressionPreservesContentAllocationAndInheritance(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "data")
+	if err := os.MkdirAll(filepath.Join(root, "artifacts"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	payload := bytes.Repeat([]byte("private compiled Bee artifact\n"), 40000)
+	file := filepath.Join(root, "artifacts", "cache")
+	if err := os.WriteFile(file, payload, 0600); err != nil {
+		t.Fatal(err)
+	}
+	_, before, err := beeUsage(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = compressBeeCache(root); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{root, filepath.Dir(file), file} {
+		requireBeeCompressed(t, path, true)
+	}
+	got, err := os.ReadFile(file)
+	if err != nil || !bytes.Equal(got, payload) {
+		t.Fatal("compression changed content", err)
+	}
+	logical, after, err := beeUsage(root)
+	if err != nil || logical != int64(len(payload)) || after >= before/2 {
+		t.Fatalf("incorrect compressed accounting: %d %d %d %v", logical, before, after, err)
+	}
+	created := filepath.Join(root, "new", "artifact")
+	if err = os.Mkdir(filepath.Dir(created), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(created, payload, 0600); err != nil {
+		t.Fatal(err)
+	}
+	requireBeeCompressed(t, filepath.Dir(created), true)
+	requireBeeCompressed(t, created, true)
+	if err = os.WriteFile(file, []byte("edited"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if got, err = os.ReadFile(file); err != nil || string(got) != "edited" {
+		t.Fatal("compressed cache is not writable", err)
+	}
+}
+
+func TestBeeCompressionRejectsHardlinksBeforeMutation(t *testing.T) {
+	base := t.TempDir()
+	root := filepath.Join(base, "data")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(root, "first")
+	if err := os.WriteFile(file, []byte("private"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(file, filepath.Join(base, "outside")); err != nil {
+		t.Fatal(err)
+	}
+	if err := compressBeeCache(root); err == nil {
+		t.Fatal("hard-linked cache accepted")
+	}
+	requireBeeCompressed(t, root, false)
+	requireBeeCompressed(t, file, false)
+}
