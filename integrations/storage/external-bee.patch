+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+func TestExternalBeeNativeLifecycle(t *testing.T) {
+	root := os.Getenv("HONEYBEE_BEE_NATIVE_ROOT")
+	if root == "" {
+		t.Skip("explicit fresh owned root and elevation required")
+	}
+	if !filepath.IsAbs(root) {
+		t.Fatal("absolute root required")
+	}
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	// Preserve any uncertain disk state on failure. No automatic recursive delete.
+	token, err := windows.OpenCurrentProcessToken()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer token.Close()
+	user, err := token.GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sid := user.User.Sid.String()
+	work := filepath.Join(root, "workspaces")
+	if err = os.Mkdir(work, 0700); err != nil {
+		t.Fatal(err)
+	}
+	cfg := BrokerConfig{StoreRoot: filepath.Join(root, "store"), WorkspaceRoot: work, UserSID: sid}
+	broker, err := NewBroker(cfg, NewNative())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Minute)
+	defer cancel()
+	seq := 0
+	call := func(r Request) Response {
+		seq++
+		r.SchemaVersion = ProtocolSchemaVersion
+		r.RequestID = fmt.Sprintf("bee-native-%d", seq)
+		v := broker.Handle(ctx, sid, r)
+		if !v.OK {
+			t.Fatalf("%s: %+v", r.Operation, v.Error)
+		}
+		return v
+	}
+	key := CompatibilityKey{Layout: ExternalBeeLayout, SchemaVersion: ParentSchemaVersion, Digest: strings.Repeat("b", 64), Provider: Provider, Filesystem: "NTFS", VirtualBytes: 1 << 30, BlockBytes: DefaultBlockBytes, SectorBytes: DefaultSectorBytes}
+	os.Mkdir(filepath.Join(work, "seed"), 0700)
+	build := call(Request{Operation: OperationBeginParentBuild, WorkspaceID: "seed", ParentKey: &key, Source: &SourceSnapshot{}, ClientPID: os.Getpid()})
+	mount := build.ParentBuild.MountPath
+	if err = os.Mkdir(filepath.Join(mount, "Bee"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for name, value := range map[string]string{"Bee/TundraBuildState.state": "retain-state", "Bee/cache.bin": "warm-cache", "Bee/test.dag": "discard-graph", "LibraryVersion": "fixture"} {
+		if err = os.WriteFile(filepath.Join(mount, filepath.FromSlash(name)), []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	parent := call(Request{Operation: OperationCommitParent, TransactionID: build.ParentBuild.TransactionID}).Parent
+	if parent.BeeSeed == nil || parent.BeeSeed.LogicalBytes <= 0 || parent.BeeSeed.AllocatedBytes < 0 {
+		t.Fatal("seed usage missing")
+	}
+	var leases []Lease
+	for _, id := range []string{"one", "two"} {
+		os.Mkdir(filepath.Join(work, id), 0700)
+		v := call(Request{Operation: OperationAcquire, WorkspaceID: id, RunID: id, ParentKey: &key, ClientPID: os.Getpid()})
+		leases = append(leases, *v.Lease)
+	}
+	if os.Getenv("HONEYBEE_BEE_USER_PROBE") == "1" {
+		journal, e := broker.store.ReadLease(leases[0].LeaseID)
+		if e != nil {
+			t.Fatal(e)
+		}
+		cache, e := beeRoot(*journal)
+		if e != nil {
+			t.Fatal(e)
+		}
+		payload, _ := json.Marshal(map[string]string{"cache": cache, "sid": sid})
+		if e = os.WriteFile(filepath.Join(root, "user-probe.json"), payload, 0600); e != nil {
+			t.Fatal(e)
+		}
+		deadline := time.Now().Add(3 * time.Minute)
+		for {
+			if _, e = os.Stat(filepath.Join(root, "user-probe-passed.json")); e == nil {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatal("normal user probe timed out")
+			}
+			time.Sleep(time.Second)
+		}
+		if data, e := os.ReadFile(filepath.Join(cache, "data", "normal-user.txt")); e != nil || string(data) != "normal-user-write" {
+			t.Fatal("normal user data missing", e)
+		}
+	}
+	for i, l := range leases {
+		target := filepath.Join(l.MountPath, "Bee", "cache.bin")
+		requireBeeCompressed(t, target, true)
+		if data, e := os.ReadFile(target); e != nil || string(data) != "warm-cache" {
+			t.Fatalf("seed read %q %v", data, e)
+		}
+		if _, e := os.Stat(filepath.Join(l.MountPath, "Bee", "test.dag")); !os.IsNotExist(e) {
+			t.Fatal("DAG retained")
+		}
+		if e := os.WriteFile(target, []byte(fmt.Sprintf("private-%d", i)), 0600); e != nil {
+			t.Fatal(e)
+		}
+		if i == 0 {
+			// Model an hb11 retained cache: ownership/layout are identical, but
+			// neither its directories nor files have compression enabled.
+			j, e := broker.store.ReadLease(l.LeaseID)
+			if e != nil {
+				t.Fatal(e)
+			}
+			cache, e := beeRoot(*j)
+			if e != nil {
+				t.Fatal(e)
+			}
+			tree, e := openBeeTree(filepath.Join(cache, "data"), 3)
+			if e != nil {
+				t.Fatal(e)
+			}
+			for _, n := range tree.nodes {
+				format := uint16(0)
+				var returned uint32
+				if e = windows.DeviceIoControl(windows.Handle(n.file.Fd()), 0x9c040, (*byte)(unsafe.Pointer(&format)), 2, nil, 0, &returned, nil); e != nil {
+					tree.close()
+					t.Fatal(e)
+				}
+			}
+			if e = tree.close(); e != nil {
+				t.Fatal(e)
+			}
+		}
+		call(Request{Operation: OperationRelease, LeaseID: l.LeaseID, RetainChild: true})
+	}
+	// Recreate the broker (service restart equivalent for persisted state).
+	broker, err = NewBroker(cfg, NewNative())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, l := range leases {
+		id := []string{"one", "two"}[i]
+		v := call(Request{Operation: OperationAttachRetained, WorkspaceID: id, RunID: id, ClientPID: os.Getpid()})
+		leases[i] = *v.Lease
+		if data, e := os.ReadFile(filepath.Join(v.Lease.MountPath, "Bee", "cache.bin")); e != nil || string(data) != fmt.Sprintf("private-%d", i) {
+			t.Fatalf("reattach reseeded %q %v", data, e)
+		}
+		requireBeeCompressed(t, filepath.Join(v.Lease.MountPath, "Bee", "cache.bin"), i != 0)
+		_ = l
+	}
+	probe, err := os.Open(filepath.Join(leases[0].MountPath, "Bee", "cache.bin"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	seq++
+	busy := broker.Handle(ctx, sid, Request{SchemaVersion: ProtocolSchemaVersion, RequestID: fmt.Sprintf("bee-native-%d", seq), Operation: OperationPrepareRetainedRemoval, RunID: "one", WorkspaceID: "one", TransactionID: "remove-one"})
+	probe.Close()
+	if busy.OK || busy.Error.Code != "retained-in-use" {
+		t.Fatalf("busy cache accepted: %+v", busy)
+	}
+	call(Request{Operation: OperationPrepareRetainedRemoval, RunID: "one", WorkspaceID: "one", TransactionID: "remove-one"})
+	call(Request{Operation: OperationAbortRetainedRemoval, RunID: "one", TransactionID: "remove-one"})
+	if data, e := os.ReadFile(filepath.Join(leases[0].MountPath, "Bee", "cache.bin")); e != nil || string(data) != "private-0" {
+		t.Fatal("abort changed data", e)
+	}
+	for _, id := range []string{"one", "two"} {
+		call(Request{Operation: OperationPrepareRetainedRemoval, RunID: id, WorkspaceID: id, TransactionID: "commit-" + id})
+		if id == "one" {
+			// Simulate a late external-cache writer after reservation. The child
+			// is deleted, but the new cache entry prevents directory removal.
+			entry := broker.removals[id]
+			journal, e := broker.store.ReadLease(leases[0].LeaseID)
+			if e != nil {
+				t.Fatal(e)
+			}
+			cache, e := beeRoot(*journal)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if e = os.WriteFile(filepath.Join(cache, "data", "late-writer"), []byte("late"), 0600); e != nil {
+				t.Fatal(e)
+			}
+			seq++
+			failed := broker.Handle(ctx, sid, Request{SchemaVersion: ProtocolSchemaVersion, RequestID: fmt.Sprintf("bee-native-%d", seq), Operation: OperationCommitRetainedRemoval, RunID: id, TransactionID: "commit-" + id})
+			if failed.OK {
+				t.Fatal("late cache entry did not interrupt removal")
+			}
+			if _, e = os.Stat(journal.ChildPath); !os.IsNotExist(e) {
+				t.Fatal("expected child deletion before injected cache failure")
+			}
+			_ = entry.reservation.Abort() // close handles as process exit would
+			// Retain the survivor before recreating the broker to avoid orphaning its attachment.
+			call(Request{Operation: OperationRelease, LeaseID: leases[1].LeaseID, RetainChild: true})
+			broker, e = NewBroker(cfg, NewNative())
+			if e != nil {
+				t.Fatal(e)
+			}
+			v := call(Request{Operation: OperationAttachRetained, RunID: "two", WorkspaceID: "two", ClientPID: os.Getpid()})
+			leases[1] = *v.Lease
+		}
+		call(Request{Operation: OperationCommitRetainedRemoval, RunID: id, TransactionID: "commit-" + id})
+		if id == "one" {
+			if data, e := os.ReadFile(filepath.Join(leases[1].MountPath, "Bee", "cache.bin")); e != nil || string(data) != "private-1" {
+				t.Fatal("survivor changed", e)
+			}
+		}
+	}
+	if _, err = broker.store.RemoveParentIfUnused(key.Digest, map[string]bool{}); err != nil {
+		t.Fatal(err)
+	}
+	status := call(Request{Operation: OperationStatus}).Status
+	if status.ParentCount != 0 || status.ActiveChildCount != 0 || status.RetainedChildCount != 0 {
+		t.Fatalf("residual: %+v", status)
+	}
+	if err = os.WriteFile(filepath.Join(root, "PASSED"), []byte("native parent, two private caches, restart, busy/abort/remove/survivor and GC passed\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
