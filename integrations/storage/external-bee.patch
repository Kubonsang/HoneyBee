+package workspace
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+type beeOwner struct {
+	Layout         string `json:"layout"`
+	LeaseID        string `json:"leaseId"`
+	ParentKey      string `json:"parentKey"`
+	OwnershipToken string `json:"ownershipToken"`
+}
+
+func beeRoot(j LeaseJournal) (string, error) {
+	if j.Layout != ExternalBeeLayout || !identifierPattern.MatchString(j.LeaseID) || !digestPattern.MatchString(j.ParentKey) || j.OwnershipToken == "" || !filepath.IsAbs(j.ChildPath) || filepath.Base(j.ChildPath) != j.LeaseID+".vhdx" || filepath.Base(filepath.Dir(j.ChildPath)) != "children" {
+		return "", ErrOwnershipMismatch
+	}
+	return strings.TrimSuffix(j.ChildPath, ".vhdx") + ".bee", nil
+}
+func beeIdentity(j LeaseJournal) beeOwner {
+	return beeOwner{ExternalBeeLayout, j.LeaseID, j.ParentKey, j.OwnershipToken}
+}
+func (b *Broker) cleanupChildCache(ctx context.Context, j LeaseJournal) error {
+	if j.Layout == "" {
+		return nil
+	}
+	if _, err := os.Lstat(j.ChildPath); !os.IsNotExist(err) {
+		return errors.Join(err, ErrOwnershipMismatch)
+	}
+	cleaner, ok := b.native.(interface {
+		CleanupChildCache(context.Context, LeaseJournal) error
+	})
+	if !ok {
+		return ErrBrokerUnavailable
+	}
+	return cleaner.CleanupChildCache(ctx, j)
+}
+func omitBeeDAG(name string) bool {
+	if strings.HasSuffix(name, "-inputdata.json") {
+		return true
+	}
+	for _, suffix := range []string{".dag", ".dag.json", ".dag.outputdata", ".dag.payloads", ".dag_derived", ".dag_fsmtime"} {
+		if strings.HasSuffix(name, suffix) {
+			return true
+		}
+	}
+	return false
+}
