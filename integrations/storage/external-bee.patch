@@ -0,0 +1,46 @@
+//go:build windows
+
+package workspace
+
+import (
+	"encoding/binary"
+	"errors"
+	"strings"
+	"unicode/utf16"
+
+	"golang.org/x/sys/windows"
+)
+
+// Query the leaf reparse buffer directly. EvalSymlinks cannot reliably resolve
+// directory volume mount ancestors on Windows and can report a false link loop.
+func beeJunctionTarget(path string) (string, error) {
+	p, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return "", err
+	}
+	h, err := windows.CreateFile(p, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if err != nil {
+		return "", err
+	}
+	defer windows.CloseHandle(h)
+	buffer := make([]byte, 16*1024)
+	var n uint32
+	if err = windows.DeviceIoControl(h, 0x900a8, nil, 0, &buffer[0], uint32(len(buffer)), &n, nil); err != nil {
+		return "", err
+	}
+	if n < 16 || binary.LittleEndian.Uint32(buffer[:4]) != 0xa0000003 {
+		return "", errors.New("Bee is not a junction")
+	}
+	offset := int(binary.LittleEndian.Uint16(buffer[8:10]))
+	length := int(binary.LittleEndian.Uint16(buffer[10:12]))
+	if length%2 != 0 || 16+offset+length > int(n) {
+		return "", errors.New("invalid junction buffer")
+	}
+	data := buffer[16+offset : 16+offset+length]
+	chars := make([]uint16, len(data)/2)
+	for i := range chars {
+		chars[i] = binary.LittleEndian.Uint16(data[i*2 : i*2+2])
+	}
+	target := string(utf16.Decode(chars))
+	return strings.TrimPrefix(target, `\??\`), nil
+}
diff --git a/workspace/bee_native_windows.go b/workspace/bee_native_windows.go
new file mode 100644
index 0000000..8ca278f
--- /dev/null
+++ b/workspace/bee_native_windows.go
@@ -0,0 +1,229 @@
+//go:build windows
+
+package workspace
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/Kubonsang/unity-workspace-storage/storage"
+)
+
+// Freeze the producer's volume before privileged copying. The seed is read
+// only from this read-only attachment; all traversed objects are pinned and
+// reparse/hard-link entries are rejected by openBeeTree.
+func (s *windowsParentSession) externalizeBee(ctx context.Context) (err error) {
+	if s.pending.Key.Layout != "" && s.pending.Key.Layout != ExternalBeeLayout {
+		return ErrInvalidInput
+	}
+	if s.pending.Key.Layout == "" || s.evidence.BeeSeed != nil {
+		return nil
+	}
+	seed := filepath.Join(filepath.Dir(s.pending.StagingPath), "bee-seed")
+	commitProgress(ctx, "bee-freeze")
+	if _, e := os.Lstat(seed); !os.IsNotExist(e) {
+		return errors.Join(e, ErrOwnershipMismatch)
+	}
+	if err = s.attachment.Flush(ctx); err != nil {
+		return err
+	}
+	if err = s.attachment.Close(ctx); err != nil {
+		return err
+	}
+	s.closed = true
+	ro, err := storage.OpenAndAttach(s.pending.StagingPath, true)
+	if err != nil {
+		return err
+	}
+	if err = ro.MountExisting(ctx, s.pending.MountPath, true); err != nil {
+		return errors.Join(err, ro.Close(ctx))
+	}
+	commitProgress(ctx, "bee-copy")
+	tree, err := openBeeTreeProgress(filepath.Join(s.pending.MountPath, "Bee"), 1, func() { commitProgress(ctx, "bee-copy") })
+	if err == nil {
+		if !strings.EqualFold(fmt.Sprintf("%08X", tree.nodes[0].volumeSerial), s.evidence.Volume.VolumeSerial) {
+			err = ErrOwnershipMismatch
+		} else {
+			err = tree.copyTo(seed, true)
+		}
+		err = errors.Join(err, tree.close())
+	}
+	err = errors.Join(err, ro.Close(ctx))
+	if err != nil {
+		return err
+	}
+	commitProgress(ctx, "bee-digest")
+	seedTree, err := openBeeTreeProgress(seed, 1, func() { commitProgress(ctx, "bee-digest") })
+	if err != nil {
+		return err
+	}
+	digest, err := seedTree.digest()
+	logical, allocated, usageErr := seedTree.usage()
+	err = errors.Join(err, usageErr, seedTree.close())
+	if err != nil {
+		return err
+	}
+	// Reopen only the owned staging disk to remove the regular Bee source tree.
+	rw, err := storage.OpenAndAttach(s.pending.StagingPath, false)
+	if err != nil {
+		return err
+	}
+	s.attachment = rw
+	s.closed = false
+	if err = rw.MountExisting(ctx, s.pending.MountPath, false); err != nil {
+		return err
+	}
+	commitProgress(ctx, "bee-remove")
+	removeTree, removeErr := openBeeTreeProgress(filepath.Join(s.pending.MountPath, "Bee"), 2, func() { commitProgress(ctx, "bee-remove") })
+	if removeErr != nil {
+		return removeErr
+	}
+	err = errors.Join(removeTree.remove(), removeTree.close())
+	if err != nil {
+		return err
+	}
+	commitProgress(ctx, "bee-acl")
+	if err = setBeeAccess(seed, s.pending.UserSID, false); err != nil {
+		return err
+	}
+	s.evidence.BeeSeed = &BeeSeed{SHA256: digest, LogicalBytes: logical, AllocatedBytes: allocated}
+	return nil
+}
+func verifyBeeSeed(parent ParentMetadata) error {
+	return verifyBeeSeedProgress(parent, nil)
+}
+func verifyBeeSeedProgress(parent ParentMetadata, progress func()) error {
+	if parent.CompatibilityKey.Layout == "" {
+		if parent.BeeSeed != nil {
+			return ErrOwnershipMismatch
+		}
+		return nil
+	}
+	if parent.CompatibilityKey.Layout != ExternalBeeLayout || parent.BeeSeed == nil {
+		return ErrOwnershipMismatch
+	}
+	tree, err := openBeeTreeProgress(filepath.Join(filepath.Dir(parent.VHDXPath), "bee-seed"), 1, progress)
+	if err != nil {
+		return err
+	}
+	defer tree.close()
+	hash, err := tree.digest()
+	logical, allocated, e := tree.usage()
+	if err != nil || e != nil {
+		return errors.Join(err, e)
+	}
+	if hash != parent.BeeSeed.SHA256 || logical != parent.BeeSeed.LogicalBytes || allocated != parent.BeeSeed.AllocatedBytes {
+		return ErrOwnershipMismatch
+	}
+	return nil
+}
+func validateBeeSeedForCommit(p *PendingParent, seed *BeeSeed) error {
+	return verifyBeeSeed(ParentMetadata{CompatibilityKey: p.Key, VHDXPath: p.StagingPath, BeeSeed: seed})
+}
+func validateBeeSeedForCommitProgress(p *PendingParent, seed *BeeSeed, progress func()) error {
+	return verifyBeeSeedProgress(ParentMetadata{CompatibilityKey: p.Key, VHDXPath: p.StagingPath, BeeSeed: seed}, progress)
+}
+func createBeeCache(parent ParentMetadata, j LeaseJournal) error {
+	root, err := beeRoot(j)
+	if err != nil {
+		return err
+	}
+	if err = os.Mkdir(root, 0700); err != nil {
+		return err
+	}
+	// The broker-owned container and marker remain read-only to the client. Only
+	// data/ and its descendants allow Unity writes; data/ itself cannot be replaced.
+	if err = setBeeAccess(root, j.UserSID, false); err != nil {
+		return err
+	}
+	if err = writeJSONExclusive(filepath.Join(root, "owner.json"), beeIdentity(j)); err != nil {
+		return err
+	}
+	tree, err := openBeeTree(filepath.Join(filepath.Dir(parent.VHDXPath), "bee-seed"), 1)
+	if err != nil {
+		return err
+	}
+	defer tree.close()
+	if err = tree.copyTo(filepath.Join(root, "data"), false); err != nil {
+		return err
+	}
+	// Compress only the new private copy before granting Unity write access.
+	// Retained caches and immutable parent seeds keep their existing state.
+	if err = compressBeeCache(filepath.Join(root, "data")); err != nil {
+		return fmt.Errorf("compress private Bee cache: %w", err)
+	}
+	return setBeeAccess(filepath.Join(root, "data"), j.UserSID, true)
+}
+func validateBeeCache(j LeaseJournal) (string, error) {
+	root, err := beeRoot(j)
+	if err != nil {
+		return "", err
+	}
+	if err = validatePlatformNonReparse(root); err != nil {
+		return "", err
+	}
+	var owner beeOwner
+	if err = readJSON(filepath.Join(root, "owner.json"), &owner); err != nil {
+		return "", err
+	}
+	if owner != beeIdentity(j) {
+		return "", ErrOwnershipMismatch
+	}
+	data := filepath.Join(root, "data")
+	if err = validatePlatformNonReparse(data); err != nil {
+		return "", err
+	}
+	return data, nil
+}
+func setupBeeJunction(ctx context.Context, j LeaseJournal, create bool) error {
+	if j.Layout == "" {
+		return nil
+	}
+	target, err := validateBeeCache(j)
+	if err != nil {
+		return err
+	}
+	link := filepath.Join(j.MountPath, "Bee")
+	if create {
+		if _, err = os.Lstat(link); !os.IsNotExist(err) {
+			return errors.Join(err, ErrOwnershipMismatch)
+		}
+		cmd := exec.CommandContext(ctx, "powershell.exe", "-NoProfile", "-NonInteractive", "-Command", `$ErrorActionPreference='Stop'; New-Item -ItemType Junction -Path $env:HB_BEE_LINK -Target $env:HB_BEE_TARGET | Out-Null`)
+		cmd.Env = append(os.Environ(), "HB_BEE_LINK="+link, "HB_BEE_TARGET="+target)
+		if out, e := cmd.CombinedOutput(); e != nil {
+			return fmt.Errorf("create private Bee junction: %w: %s", e, out)
+		}
+	}
+	actual, err := beeJunctionTarget(link)
+	if err != nil || !strings.EqualFold(actual, target) {
+		return errors.Join(err, ErrOwnershipMismatch)
+	}
+	return nil
+}
+func (windowsNative) CleanupChildCache(_ context.Context, j LeaseJournal) error {
+	root, err := beeRoot(j)
+	if err != nil {
+		return err
+	}
+	if _, err = os.Lstat(root); os.IsNotExist(err) {
+		return nil
+	}
+	// A missing data directory is allowed only here, after child deletion, to
+	// resume a partially completed removal. The protected ownership marker is last.
+	var owner beeOwner
+	if err = validatePlatformNonReparse(root); err != nil {
+		return err
+	}
+	if err = readJSON(filepath.Join(root, "owner.json"), &owner); err != nil {
+		return err
+	}
+	if owner != beeIdentity(j) {
+		return ErrOwnershipMismatch
+	}
+	return removeBeeTree(root)
+}
diff --git a/workspace/bee_tree_windows.go b/workspace/bee_tree_windows.go
new file mode 100644
index 0000000..8508d30
--- /dev/null
+++ b/workspace/bee_tree_windows.go
@@ -0,0 +1,326 @@
+//go:build windows
+
+package workspace
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"github.com/Kubonsang/unity-workspace-storage/storage"
+	"golang.org/x/sys/windows"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"unsafe"
+)
+
+// Pin each ancestor before opening descendants. Open reparse points themselves
+// and reject them, and reject hard-linked files. A directory cannot be swapped
+// between validation and a privileged read/delete. Mode 2 reserves every file
+// exclusively before deletion; mode 0 measures without blocking normal writers.
+// Mode 3 permits compression through the pinned handles before publication.
+type beeNode struct {
+	path         string
+	file         *os.File
+	info         os.FileInfo
+	volumeSerial uint32
+}
+type beeTree struct {
+	nodes    []beeNode
+	progress func()
+}
+
+type progressReader struct {
+	io.Reader
+	progress func()
+}
+
+func (r progressReader) Read(p []byte) (int, error) {
+	n, err := r.Reader.Read(p)
+	if n > 0 && r.progress != nil {
+		r.progress()
+	}
+	return n, err
+}
+
+var beeStandardInfo = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetFileInformationByHandleEx")
+
+func beeAllocated(n beeNode) (int64, error) {
+	var id windows.ByHandleFileInformation
+	if err := windows.GetFileInformationByHandle(windows.Handle(n.file.Fd()), &id); err != nil {
+		return 0, err
+	}
+	if id.FileAttributes&(windows.FILE_ATTRIBUTE_COMPRESSED|windows.FILE_ATTRIBUTE_SPARSE_FILE) != 0 {
+		usage, err := storage.FileUsageOf(n.path)
+		return usage.AllocatedBytes, err
+	}
+	var standard struct {
+		AllocationSize, EndOfFile int64
+		Links                     uint32
+		DeletePending, Directory  uint8
+		Padding                   [2]byte
+	}
+	ok, _, err := beeStandardInfo.Call(n.file.Fd(), 1, uintptr(unsafe.Pointer(&standard)), unsafe.Sizeof(standard))
+	if ok == 0 {
+		return 0, err
+	}
+	return standard.AllocationSize, nil
+}
+func beeFileAllocatedBytes(path string) (int64, error) {
+	t, err := openBeeTree(path, 0)
+	if err != nil {
+		return 0, err
+	}
+	defer t.close()
+	if len(t.nodes) != 1 || t.nodes[0].info.IsDir() {
+		return 0, ErrOwnershipMismatch
+	}
+	return beeAllocated(t.nodes[0])
+}
+
+func (t *beeTree) close() error {
+	var err error
+	for i := len(t.nodes) - 1; i >= 0; i-- {
+		if t.nodes[i].file != nil {
+			err = errors.Join(err, t.nodes[i].file.Close())
+			t.nodes[i].file = nil
+		}
+	}
+	return err
+}
+func openBeeTree(root string, mode int) (*beeTree, error) {
+	return openBeeTreeProgress(root, mode, nil)
+}
+func openBeeTreeProgress(root string, mode int, progress func()) (*beeTree, error) {
+	t := &beeTree{progress: progress}
+	var visit func(string) error
+	visit = func(p string) error {
+		ptr, err := windows.UTF16PtrFromString(p)
+		if err != nil {
+			return err
+		}
+		access := uint32(windows.FILE_READ_ATTRIBUTES)
+		share := uint32(windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE)
+		if mode > 0 {
+			access |= windows.GENERIC_READ
+			share = windows.FILE_SHARE_READ
+		}
+		// A separate leaf probe determines type, then the pinned handle verifies it.
+		attrs, err := windows.GetFileAttributes(ptr)
+		if err != nil {
+			return err
+		}
+		if mode == 2 {
+			access |= windows.DELETE
+			share = 0
+		}
+		if mode == 3 {
+			access |= windows.GENERIC_WRITE
+		}
+		if attrs&windows.FILE_ATTRIBUTE_DIRECTORY != 0 {
+			access |= windows.FILE_LIST_DIRECTORY
+			share = windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE
+		}
+		h, err := windows.CreateFile(ptr, access, share, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+		if err != nil {
+			return err
+		}
+		f := os.NewFile(uintptr(h), p)
+		var id windows.ByHandleFileInformation
+		if err = windows.GetFileInformationByHandle(h, &id); err != nil {
+			f.Close()
+			return err
+		}
+		if id.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (id.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY == 0 && id.NumberOfLinks != 1) {
+			f.Close()
+			return ErrOwnershipMismatch
+		}
+		info, err := f.Stat()
+		if err != nil {
+			f.Close()
+			return err
+		}
+		if !info.IsDir() && !info.Mode().IsRegular() {
+			f.Close()
+			return ErrOwnershipMismatch
+		}
+		t.nodes = append(t.nodes, beeNode{p, f, info, id.VolumeSerialNumber})
+		if progress != nil {
+			progress()
+		}
+		if info.IsDir() {
+			entries, err := f.ReadDir(-1)
+			if err != nil {
+				return err
+			}
+			sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+			// Keep the ownership marker until all cache data has been removed.
+			for _, e := range entries {
+				if e.Name() == "owner.json" {
+					if err = visit(filepath.Join(p, e.Name())); err != nil {
+						return err
+					}
+				}
+			}
+			for _, e := range entries {
+				if e.Name() != "owner.json" {
+					if err = visit(filepath.Join(p, e.Name())); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		return nil
+	}
+	if err := visit(root); err != nil {
+		t.close()
+		return nil, err
+	}
+	return t, nil
+}
+func (t *beeTree) digest() (string, error) {
+	h := sha256.New()
+	root := t.nodes[0].path
+	for _, n := range t.nodes {
+		rel, err := filepath.Rel(root, n.path)
+		if err != nil {
+			return "", err
+		}
+		fmt.Fprintf(h, "%s\x00%t\x00%d\x00", filepath.ToSlash(rel), n.info.IsDir(), n.info.Size())
+		if !n.info.IsDir() {
+			if _, err = n.file.Seek(0, 0); err != nil {
+				return "", err
+			}
+			if _, err = io.Copy(h, progressReader{n.file, t.progress}); err != nil {
+				return "", err
+			}
+		}
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+func (t *beeTree) usage() (logical, allocated int64, err error) {
+	for _, n := range t.nodes {
+		if !n.info.IsDir() {
+			bytes, e := beeAllocated(n)
+			if e != nil {
+				return 0, 0, e
+			}
+			logical += n.info.Size()
+			allocated += bytes
+			if t.progress != nil {
+				t.progress()
+			}
+		}
+	}
+	return
+}
+func (t *beeTree) copyTo(target string, omit bool) error {
+	root := t.nodes[0].path
+	for _, n := range t.nodes {
+		rel, err := filepath.Rel(root, n.path)
+		if err != nil {
+			return err
+		}
+		if omit && filepath.Dir(rel) == "." && omitBeeDAG(filepath.Base(rel)) {
+			if n.info.IsDir() {
+				return ErrOwnershipMismatch
+			}
+			continue
+		}
+		dst := filepath.Join(target, rel)
+		if n.info.IsDir() {
+			if err = os.Mkdir(dst, 0700); err != nil {
+				return err
+			}
+			continue
+		}
+		out, err := os.OpenFile(dst, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return err
+		}
+		_, err = n.file.Seek(0, 0)
+		if err == nil {
+			_, err = io.Copy(out, progressReader{n.file, t.progress})
+		}
+		err = errors.Join(err, out.Sync(), out.Close())
+		if err != nil {
+			return err
+		}
+		if err = os.Chtimes(dst, n.info.ModTime(), n.info.ModTime()); err != nil {
+			return err
+		}
+		if t.progress != nil {
+			t.progress()
+		}
+	}
+	return nil
+}
+
+// Delete exactly the held objects, never resolve a child path again. New files
+// or open handles cause failure and leave the owning journal for retry.
+func (t *beeTree) remove() error {
+	for i := len(t.nodes) - 1; i >= 0; i-- {
+		n := &t.nodes[i]
+		if n.file == nil {
+			continue
+		}
+		flag := byte(1)
+		if err := windows.SetFileInformationByHandle(windows.Handle(n.file.Fd()), windows.FileDispositionInfo, &flag, uint32(unsafe.Sizeof(flag))); err != nil {
+			return err
+		}
+		if err := n.file.Close(); err != nil {
+			return err
+		}
+		n.file = nil
+		if t.progress != nil {
+			t.progress()
+		}
+	}
+	return nil
+}
+func beeUsage(root string) (int64, int64, error) {
+	t, e := openBeeTree(root, 0)
+	if e != nil {
+		return 0, 0, e
+	}
+	defer t.close()
+	return t.usage()
+}
+func removeBeeTree(root string) error {
+	t, e := openBeeTree(root, 2)
+	if os.IsNotExist(e) {
+		return nil
+	}
+	if e != nil {
+		return e
+	}
+	defer t.close()
+	return t.remove()
+}
+func setBeeAccess(path, sid string, writable bool) error {
+	parsed, err := windows.StringToSid(sid)
+	if err != nil {
+		return err
+	}
+	rights := "GRGX"
+	inherit := "OICI"
+	if writable {
+		rights = "0x1201bf"
+		inherit = ""
+	}
+	sddl := fmt.Sprintf("D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;%s;%s;;;%s)", inherit, rights, parsed.String())
+	if writable {
+		sddl += fmt.Sprintf("(A;OICIIO;FA;;;%s)", parsed.String())
+	}
+	sd, err := windows.SecurityDescriptorFromString(sddl)
+	if err != nil {
+		return err
+	}
+	acl, _, err := sd.DACL()
+	if err != nil {
+		return err
+	}
+	return windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil)
+}
