@@ -0,0 +1,208 @@
+package workspace
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func beginRecoveryParent(t *testing.T, broker *Broker, key CompatibilityKey, workspaces string) string {
+	t.Helper()
+	if err := os.Mkdir(filepath.Join(workspaces, "builder"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	req := request(OperationBeginParentBuild, "recovery-begin")
+	req.ParentKey, req.Source, req.WorkspaceID = &key, &SourceSnapshot{}, "builder"
+	req.ClientPID = 12345 // fakeNative reports this exited CLI as dead.
+	response := broker.Handle(context.Background(), "S-1-5-21-test", req)
+	if !response.OK || response.ParentBuild == nil {
+		t.Fatalf("begin=%+v", response)
+	}
+	return response.ParentBuild.TransactionID
+}
+
+func assertPendingPreserved(t *testing.T, broker *Broker) {
+	t.Helper()
+	summary, err := broker.Recover(context.Background(), 30*time.Second)
+	if err != nil || summary.Quarantined != 0 || summary.Preserved != 1 {
+		t.Fatalf("active parent recovery: summary=%+v err=%v", summary, err)
+	}
+}
+
+func TestParentRecoveryPreservesSessionAfterBeginCLIExits(t *testing.T) {
+	broker, key, workspaces := testBroker(t, &fakeNative{})
+	transaction := beginRecoveryParent(t, broker, key, workspaces)
+	broker.now = func() time.Time { return time.Now().Add(time.Hour) }
+	assertPendingPreserved(t, broker)
+	req := request(OperationCommitParent, "recovery-commit")
+	req.TransactionID = transaction
+	response := broker.Handle(context.Background(), "S-1-5-21-test", req)
+	if !response.OK {
+		t.Fatalf("commit=%+v error=%+v", response, response.Error)
+	}
+	if len(broker.pending) != 0 || len(broker.parents) != 0 {
+		t.Fatal("completed session retained")
+	}
+}
+
+type gatedRecoverySession struct {
+	ParentSession
+	entered, release chan struct{}
+}
+
+type gatedRecoveryNative struct {
+	*fakeNative
+	entered, release chan struct{}
+}
+
+func (native *gatedRecoveryNative) BeginParent(ctx context.Context, pending *PendingParent) (ParentSession, error) {
+	close(native.entered)
+	select {
+	case <-native.release:
+		return native.fakeNative.BeginParent(ctx, pending)
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func TestParentRecoveryCannotScanUnregisteredBeginJournal(t *testing.T) {
+	broker, key, workspaces := testBroker(t, &fakeNative{})
+	native := &gatedRecoveryNative{fakeNative: &fakeNative{}, entered: make(chan struct{}), release: make(chan struct{})}
+	broker.native = native
+	broker.now = func() time.Time { return time.Now().Add(time.Hour) }
+	if err := os.Mkdir(filepath.Join(workspaces, "builder"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	done := make(chan Response, 1)
+	go func() {
+		req := request(OperationBeginParentBuild, "slow-begin")
+		req.ParentKey, req.Source, req.WorkspaceID = &key, &SourceSnapshot{}, "builder"
+		done <- broker.Handle(ctx, "S-1-5-21-test", req)
+	}()
+	select {
+	case <-native.entered:
+	case <-ctx.Done():
+		t.Fatal("begin did not start")
+	}
+	// The durable journal exists, but the native session is not registered yet.
+	if broker.parentRecoveryMu.TryLock() {
+		broker.parentRecoveryMu.Unlock()
+		t.Fatal("recovery can enter the journal/session registration gap")
+	}
+	recovered := make(chan error, 1)
+	go func() {
+		summary, err := broker.Recover(ctx, 30*time.Second)
+		if err == nil && (summary.Preserved != 1 || summary.Quarantined != 0) {
+			err = fmt.Errorf("summary=%+v", summary)
+		}
+		recovered <- err
+	}()
+	close(native.release)
+	select {
+	case response := <-done:
+		if !response.OK {
+			t.Fatalf("begin=%+v", response)
+		}
+	case <-ctx.Done():
+		t.Fatal("begin did not finish")
+	}
+	select {
+	case err := <-recovered:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("recovery did not finish")
+	}
+}
+
+func (session *gatedRecoverySession) Finalize(ctx context.Context) (ParentEvidence, error) {
+	close(session.entered)
+	select {
+	case <-session.release:
+		return session.ParentSession.Finalize(ctx)
+	case <-ctx.Done():
+		return ParentEvidence{}, ctx.Err()
+	}
+}
+
+func TestParentRecoveryDuringFinalizeDoesNotWaitOrQuarantine(t *testing.T) {
+	broker, key, workspaces := testBroker(t, &fakeNative{})
+	transaction := beginRecoveryParent(t, broker, key, workspaces)
+	broker.now = func() time.Time { return time.Now().Add(time.Hour) }
+	session := &gatedRecoverySession{ParentSession: broker.parents[transaction], entered: make(chan struct{}), release: make(chan struct{})}
+	broker.parents[transaction] = session
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	done := make(chan Response, 1)
+	go func() {
+		req := request(OperationCommitParent, "blocked-commit")
+		req.TransactionID = transaction
+		done <- broker.Handle(ctx, "S-1-5-21-test", req)
+	}()
+	select {
+	case <-session.entered:
+	case <-ctx.Done():
+		t.Fatal("finalize did not start")
+	}
+	assertPendingPreserved(t, broker)
+	close(session.release)
+	select {
+	case response := <-done:
+		if !response.OK {
+			t.Fatalf("commit=%+v error=%+v", response, response.Error)
+		}
+	case <-ctx.Done():
+		t.Fatal("commit did not finish")
+	}
+}
+
+func TestParentRecoveryAfterRestartStillQuarantinesOrphan(t *testing.T) {
+	native := &fakeNative{}
+	broker, key, workspaces := testBroker(t, native)
+	beginRecoveryParent(t, broker, key, workspaces)
+	restarted, err := NewBroker(broker.config, native)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restarted.now = func() time.Time { return time.Now().Add(time.Hour) }
+	summary, err := restarted.Recover(context.Background(), 30*time.Second)
+	if err != nil || summary.Quarantined != 1 {
+		t.Fatalf("summary=%+v err=%v", summary, err)
+	}
+}
+
+func TestParentRecoveryDoesNotProtectMismatchedOwnership(t *testing.T) {
+	broker, key, workspaces := testBroker(t, &fakeNative{})
+	transaction := beginRecoveryParent(t, broker, key, workspaces)
+	active := *broker.pending[transaction]
+	active.OwnershipToken = "different-token"
+	broker.pending[transaction] = &active
+	broker.now = func() time.Time { return time.Now().Add(time.Hour) }
+	summary, err := broker.Recover(context.Background(), 30*time.Second)
+	if err != nil || summary.Quarantined != 1 {
+		t.Fatalf("summary=%+v err=%v", summary, err)
+	}
+}
+
+func TestParentRecoveryPreservesUntilExplicitAbort(t *testing.T) {
+	broker, key, workspaces := testBroker(t, &fakeNative{})
+	transaction := beginRecoveryParent(t, broker, key, workspaces)
+	broker.now = func() time.Time { return time.Now().Add(time.Hour) }
+	assertPendingPreserved(t, broker)
+	req := request(OperationAbortParent, "recovery-abort")
+	req.TransactionID = transaction
+	response := broker.Handle(context.Background(), "S-1-5-21-test", req)
+	if !response.OK {
+		t.Fatalf("abort=%+v", response)
+	}
+	summary, err := broker.Recover(context.Background(), 30*time.Second)
+	if err != nil || summary.Preserved != 0 || summary.Quarantined != 0 {
+		t.Fatalf("summary=%+v err=%v", summary, err)
+	}
+}
