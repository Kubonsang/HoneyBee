diff --git a/workspace/commit_progress.go b/workspace/commit_progress.go
new file mode 100644
index 0000000..9089e04
--- /dev/null
+++ b/workspace/commit_progress.go
@@ -0,0 +1,86 @@
+package workspace
+
+import (
+	"context"
+	"strings"
+)
+
+// Sequence changes only at worker checkpoints, never merely because a client
+// polls. A responsive observation proves service liveness, not worker progress.
+type CommitObservation struct {
+	Version         int       `json:"version"`
+	BrokerSessionID string    `json:"brokerSessionId"`
+	RequestID       string    `json:"requestId"`
+	TransactionID   string    `json:"transactionId"`
+	State           string    `json:"state"`
+	Phase           string    `json:"phase"`
+	Sequence        uint64    `json:"sequence"`
+	Result          *Response `json:"result,omitempty"`
+}
+
+type commitProgressKey struct{}
+
+func commitProgress(ctx context.Context, phase string) {
+	if notify, ok := ctx.Value(commitProgressKey{}).(func(string)); ok {
+		notify(phase)
+	}
+}
+
+func (b *Broker) trackCommit(ctx context.Context, request Request) (context.Context, func()) {
+	b.mu.Lock()
+	if b.commitProgress == nil {
+		b.commitProgress = map[string]*CommitObservation{}
+	}
+	observation := &CommitObservation{Version: 1, RequestID: request.RequestID, TransactionID: request.TransactionID, State: "running", Phase: "starting", Sequence: 1}
+	b.commitProgress[request.RequestID] = observation
+	b.mu.Unlock()
+	notify := func(phase string) {
+		b.mu.Lock()
+		observation.Sequence++
+		observation.Phase = phase
+		b.mu.Unlock()
+	}
+	return context.WithValue(ctx, commitProgressKey{}, notify), func() { notify("returning") }
+}
+
+func (b *Broker) observeCommit(callerSID string, request Request) Response {
+	fail := func(code string) Response {
+		return Response{SchemaVersion: ProtocolSchemaVersion, RequestID: request.RequestID, Error: &Error{Code: code, Operation: request.Operation, Message: code}}
+	}
+	if request.SchemaVersion != ProtocolSchemaVersion || !identifierPattern.MatchString(request.RequestID) || request.WorkspaceRoot != "" {
+		return fail("invalid-request")
+	}
+	if !strings.EqualFold(callerSID, b.config.UserSID) || (request.UserSID != "" && !strings.EqualFold(request.UserSID, callerSID)) {
+		return fail("unauthorized-client")
+	}
+	if (request.TargetRequestID == "") != (request.TransactionID == "") {
+		return fail("invalid-request")
+	}
+	if request.TargetRequestID != "" && (!identifierPattern.MatchString(request.TargetRequestID) || !identifierPattern.MatchString(request.TransactionID)) {
+		return fail("invalid-request")
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.brokerSessionID == "" {
+		id, err := randomID("broker")
+		if err != nil {
+			return fail("broker-identity-unavailable")
+		}
+		b.brokerSessionID = id
+	}
+	observation := CommitObservation{Version: 1, BrokerSessionID: b.brokerSessionID, RequestID: request.TargetRequestID, TransactionID: request.TransactionID, State: "unknown"}
+	if request.TargetRequestID == "" {
+		observation.State = "capable"
+	} else if active := b.commitProgress[request.TargetRequestID]; active != nil {
+		if active.TransactionID != request.TransactionID {
+			return fail("transaction-mismatch")
+		}
+		observation = *active
+		observation.BrokerSessionID = b.brokerSessionID
+		if result, ok := b.requests[request.TargetRequestID]; ok {
+			observation.State = "completed"
+			observation.Result = &result
+		}
+	}
+	return Response{SchemaVersion: ProtocolSchemaVersion, RequestID: request.RequestID, OK: true, Provider: Provider, CommitObservation: &observation}
+}
