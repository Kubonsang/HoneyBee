+++ b/workspace/parent_recovery.go
@@ -0,0 +1,28 @@
+package workspace
+
+import "time"
+
+// A begin CLI can exit long before copying or finalization completes. Its PID
+// is not the lifetime of the service-owned parent session. Keep matching
+// in-memory ownership protected through publication or explicit abort.
+func (b *Broker) recoverPending(grace time.Duration) (int, int, error) {
+	b.parentRecoveryMu.Lock()
+	defer b.parentRecoveryMu.Unlock()
+
+	b.mu.Lock()
+	owned := make(map[string]PendingParent, len(b.pending))
+	for transaction, pending := range b.pending {
+		if pending != nil && b.parents[transaction] != nil {
+			owned[transaction] = *pending
+		}
+	}
+	b.mu.Unlock()
+
+	// Begin cannot introduce a journal after this snapshot. Commit/abort may
+	// finish concurrently; conservatively preserving their old journal for
+	// one pass is safe. No native calls run under the broker's state mutex.
+	return b.store.recoverPending(b.now(), grace, b.native.ProcessAlive, func(pending *PendingParent) bool {
+		active, ok := owned[pending.TransactionID]
+		return ok && active.Key.Digest == pending.Key.Digest && active.OwnershipToken == pending.OwnershipToken
+	})
+}
